@startuml
'https://plantuml.com/class-diagram

class Tablero {
        - casillas: Casilla[][]
        - unidades: List<Unidad>

        + Tablero(mapa:Casilla[][])
        + casillaIgualQue(x: int, y: int, comparar: Casilla): boolean
        + colocarUnidad(coordenadas: Posicion, unidad: Unidad): void
        + moverUnidad(unidad: Unidad, origen: Posicion, direccion: Direccion, distancia: int): void
        - esCoordenadaValida(posicion: Posicion):void
        - casillaEn(posicion: Posicion): Casilla
        + aplicarGolpe(posicion:Posicion, danio: int, direccion: Direccion):void
        + empujarDesde(origen:Posicion, direccion:Direccion):void
        + ataqueEnLinea(origen: Posicion, danio:int, direccion: Direccion):void
        + revertirMovimiento(unidad:Unidad, posicionActual: Posicion, posicionAnterior: Posicion):void
        + aplicarDisparo(objetivo: Posicion, danio: int):void

}

abstract class Casilla {

        - posicion: Posicion

        + Casilla(posicion: Posicion)
        + {abstract} ocupar(unidad: Unidad): void
        + {abstract} transferirUnidadA(casilla: Casilla):void
        + {abstract} unidadRecibirGolpe(danio: int , direccion: Direccion , tablero: Tablero ):void
        + {abstract} recibirEmpuje(casillaOrigen:Casilla ):void
        + {abstract} detieneDisparo():boolean
        + {abstract} recibirDanoPorColision():void
        + {abstract} desocupar():void
        + {abstract} unidadGolpeada(int danio):void


}


abstract class Transitable extends Casilla{
        - unidad: Unidad

        + Transitable(posicion:Posicion)
        + ocupar(unidad: Unidad):void
        + transferirUnidadA(casilla: Casilla): void
        + unidadRecibirGolpe(danio: int, direccion:Direccion, tablero:Tablero):void
        + recibirEmpuje(casilla: Casilla):void
        + detieneDisparo()boolean
        + recibirDanoPorColision():void
        + descocupar():void
        - estaOcupada():boolean
        + unidadGolpeada(danio:int):void

}

abstract class Obstaculo extends Casilla{
        - vida: int

        + Obstaculo(posicion: Posicion, vida:int)
        + ocupar(unidad:Unidad):void
        + transferirUnidadA(casilla:Casilla):void
        + unidadRecibirGolpe(danio: int, direccion: Direccion, tablero: Tablero):void
        + recibirEmpuje(casilla:Casilla):void
        + detieneDisparo():boolean
        + recibirDanoPorColision():void
        + desocupar():void
        + unidadGolpeada(danio:int):void
}


abstract class Unidad {
        # posicion: Posicion
        - vidaMax: int
        - rangoDeMovimiento: int
        - vidaActual: int

        + Unidad(vidaMaxima: int, rangoDeMovimiento: int)
        + verificarRangoDeMovimiento(distancia: int):void
        + moverA(nuevaPosicion: Posicion):void
        + estaEn(otraPosicion: Posicion):boolean
        + mover(direccion: Direccion, distancia: int, tablero: Tablero):void
        + obtenerVidaActual():int
        + recibirGolpe(danio: int, posicion: Posicion, direccion: Direccion, tablero: Tablero, casilla: Casilla):void
        + recibirDano(danio: int, casilla: Casilla): void

}

class Posicion {
        - x: int
        - y: int

        + Posicion(x: int, y: int)
        + desplazar(deltaX: int, deltaY: int): Posicion
        + siguienteEn(direccion: Direccion): Posicion
        + getX():int
        + getY():int
        + equals(o: Object): boolean
        + calcularDireccionHacia(objetivo: Posicion): Direccion
}

interface Direccion {

       + calcularSiguientePosicion(posicion: Posicion): Posicion
}

interface Arma {

       + ejecutarAtaque(origen: Posicion, objetivo: Posicion, tablero: Tablero):void
}


class Acido extends Transitable {
       + Acido(posicion: Posicion)
}

class Agua extends Transitable {
       + Agua(posicion: Posicion)
}

class Suelo extends Transitable {
       + Suelo(posicion: Posicion)
}

class Edificio extends Obstaculo {

       + Edificio(posicion: Posicion)
       + detieneDisparo():boolean

}

class Montania extends Obstaculo {

       + Montania(posicion: Posicion)
}


class Abajo implements Direccion {

}
class Izquierda implements Direccion {

}
class Derecha implements Direccion {

}
class Arriba implements Direccion {

}

abstract class Mech extends Unidad{
        - arma: Arma
        - movimientosDeshechos: int
        - posicionAnterior: Posicion
        - yaAtaco: boolean
        # yaSeMovio : boolean

        + Mech(vidaMax: int, movimiento: int, arma: Arma)
        + mover(direccion: Direccion, distancia: int, tablero: Tablero):void
        + atacar(posicionObjetivo: Posicion, tablero: Tablero): void
        + deshacerMovimiento(tablero:Tablero):void
}

abstract class Vek extends Unidad{

        + Vek(vidaMax: int, rangoDeMovimiento: int)
}

class Combate extends Mech{
        + Combate()
}

class Canion extends Mech{
        + Canion()
}

class Artilleria extends Mech{
        + Artilleria()
}

class Luciernaga extends Vek{
        + Luciernaga()
}

class Punio implements Arma{
        -danio:int
}

class DisparoCanion implements Arma{
        -danio:int
}

class Arco implements Arma{
        -danio:int

        - estaDentroDelRangoProhibido3x3(origen: Posicion, objetivo: Posicion): boolean
        - estaEnLineaRecta(origen: Posicion, objetivo:Posicion):boolean
}

Tablero"1" o-- "1..*"Casilla
Tablero"1" o-- "1..*"Unidad
Tablero ..> Direccion
Transitable"1" o-- "0..1"Unidad

Casilla"1" o-- "1"Posicion
Unidad"1" o-- "1"Posicion

Mech o-- Arma







@enduml
